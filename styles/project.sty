\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/project}[2026/09/08 Chinese solution document layout]
\RequirePackage{geometry}
\geometry{a4paper,top=\PageMarginTop,bottom=\PageMarginBottom,left=\PageMarginLeft,right=\PageMarginRight,headheight=16pt,headsep=8mm,footskip=12mm}
\RequirePackage{xcolor}
\definecolor{Brand}{HTML}{\BrandColorHTML}
\definecolor{Accent}{HTML}{\AccentColorHTML}
\definecolor{Muted}{HTML}{\MutedColorHTML}
\definecolor{Rule}{HTML}{\RuleColorHTML}
\definecolor{Panel}{HTML}{\PanelColorHTML}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc}
\graphicspath{{assets/}}
\RequirePackage{array,tabularx,longtable,booktabs,multirow}
\RequirePackage{enumitem}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{amsmath,amssymb}
\RequirePackage{hyperref}
\hypersetup{unicode=true,colorlinks=true,linkcolor=Brand,urlcolor=Accent,citecolor=Accent,bookmarksnumbered=true,pdftitle={\DocumentTitle},pdfauthor={\SchoolName}}
\urlstyle{same}
\linespread{\BodyLineSpread}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.28em}
\setlength{\emergencystretch}{2em}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.38}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
\setlist{nosep,topsep=5pt,itemsep=3pt,leftmargin=2em}
\ctexset{
 section={format=\Large\bfseries\sffamily\color{Brand},number=第\chinese{section}章,aftername=\hspace{.65em},beforeskip=1.2\baselineskip,afterskip=.55\baselineskip},
 subsection={format=\normalsize\bfseries\sffamily,beforeskip=.8\baselineskip,afterskip=.3\baselineskip},
 subsubsection={format=\normalsize\bfseries,beforeskip=.5\baselineskip,afterskip=.2\baselineskip}
}
\captionsetup{font=small,labelfont=bf,labelsep=quad,skip=6pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{Muted}\DocumentTitle}
\fancyhead[R]{\small\color{Muted}\DocumentVersion}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}
\newcommand{\ContentSlot}[2]{%
 \par\addvspace{.65\baselineskip}\Needspace{4\baselineskip}%
 \noindent{\bfseries #1}\par\nopagebreak
 {\small\color{Muted}\noindent #2\par}%
 \nobreak\vspace{2mm}\noindent{\color{Rule}\rule{\linewidth}{.3pt}}\par\vspace{.35\baselineskip}%
}
\newcommand{\KeyPoint}[2]{%
 \par\addvspace{.6\baselineskip}\Needspace{3\baselineskip}%
 \noindent{\bfseries\color{Accent}#1}\par\nopagebreak
 {\small\noindent #2\par}\addvspace{.3\baselineskip}%
}
\newcommand{\FigureSlot}[2]{%
 \begin{figure}[H]\centering
 \setlength{\fboxsep}{5mm}%
 \fcolorbox{Rule}{Panel}{\begin{minipage}[c][28mm][c]{\dimexpr\linewidth-10mm-2\fboxrule\relax}
 \centering{\bfseries\color{Brand}#1}\par\vspace{3mm}
 {\small\color{Muted}#2}
 \end{minipage}}%
 \caption{#1}
 \end{figure}%
}
\newcommand{\ConfigValue}[1]{{\color{Brand}#1}}
\AtBeginDocument{\hypersetup{pdfsubject={\ChallengeTitle}}}

% 目录为“第一章”等中文章号留足宽度。
\makeatletter
\renewcommand*\l@section[2]{\addvspace{.4em}\begingroup\bfseries\@dottedtocline{1}{0em}{4em}{#1}{#2}\endgroup}
\renewcommand*\l@subsection{\@dottedtocline{2}{1.5em}{2.8em}}
\makeatother

\setcounter{tocdepth}{2}

% 团队成员条目：图片保持原比例；人员内容与照片路径统一取自 config/people.tex。
\newcommand{\TeamMemberProfile}[5]{%
  \par\addvspace{\TeamProfileGap}\Needspace{44mm}%
  \noindent\begin{minipage}[t]{\TeamPhotoColumnWidth}
    \vspace{0pt}\centering
    \includegraphics[width=\TeamPhotoWidth,height=\TeamPhotoHeight,keepaspectratio]{#1}
  \end{minipage}\hfill%
  \begin{minipage}[t]{\dimexpr\linewidth-\TeamPhotoColumnWidth-5mm\relax}
    \vspace{0pt}
    {\normalsize\sffamily #2}\quad{\small\color{Muted}#3}\par
    \vspace{1mm}
    {\small\color{Muted}\raggedright #4\par}
    \vspace{1mm}
    {\small\linespread{1.12}\selectfont\setlength{\parskip}{0pt}\noindent #5\par}
  \end{minipage}\par
}
\newcommand{\TeamAdvisorProfile}[2]{%
  \par\Needspace{42mm}%
  \noindent\begin{minipage}[t]{\TeamPhotoColumnWidth}
    \vspace{0pt}\centering
    \IfFileExists{\AdvisorPhoto}{%
      \includegraphics[width=\TeamPhotoWidth,height=\TeamPhotoHeight,keepaspectratio]{\AdvisorPhoto}%
    }{%
      \setlength{\fboxsep}{0pt}%
      \fcolorbox{Rule}{Panel}{\parbox[c][\AdvisorPlaceholderHeight][c]{\TeamPhotoWidth}{\centering\small\color{Muted}\AdvisorPhotoPlaceholder}}%
    }
  \end{minipage}\hfill%
  \begin{minipage}[t]{\dimexpr\linewidth-\TeamPhotoColumnWidth-5mm\relax}
    \vspace{0pt}
    {\normalsize\sffamily #1}\quad{\small\color{Muted}#2}\par
    {\small\linespread{1.12}\selectfont\setlength{\parskip}{1mm}
      \AdvisorDepartment{} · \AdvisorQualification\par
      \AdvisorTitle\par
      学术经历：\AdvisorEducation\par
      学术任职：\AdvisorAcademicRoles{}；\AdvisorTeamRole{}。\par
      研究方向：\AdvisorResearchAreas\par
      指导分工：\AdvisorGuidance\par}
  \end{minipage}\par
}
